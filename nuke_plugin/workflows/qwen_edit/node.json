{
  "label": "Qwen Image Edit",
  "node_name": "QwenEdit",
  "tile_color": "0x3E7CB1FF",
  "output": "nuke_save",
  "bind": {
    "prompt": [["nuke_prompt", "value"]],
    "seed": [["nuke_ksampler", "seed"], ["nuke_generate_text", "sampling_mode.seed"]],
    "width": [["nuke_latent", "width"]],
    "height": [["nuke_latent", "height"]]
  },
  "set": [["nuke_size_switch", "switch", true]],
  "images": {"max": 10},
  "knobs": [
    {
      "name": "enhance",
      "label": "enhance prompt",
      "type": "bool",
      "tooltip": "Rewrite the instruction with the Qwen 3.5 LLM, which also looks at the input images. Slower.",
      "bind": [["nuke_enhance_switch", "switch"]]
    },
    {
      "name": "steps",
      "type": "int",
      "bind": [["nuke_ksampler", "steps"]]
    }
  ]
}
